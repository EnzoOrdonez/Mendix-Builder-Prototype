          "validations": [
            {
              "type": "regex",
              "params": {"pattern": ".+@.+\\..+"},
              "error_message": "Formato de email inválido"
            }
          ]
        },
        {
          "name": "Phone",
          "mendix_type": "String",
          "label": "Teléfono"
        },
        {
