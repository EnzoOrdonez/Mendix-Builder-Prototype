# ============================================
# MendixFormAgent - Variables de Entorno
# ============================================
# Copiar este archivo como .env y completar los valores

# --- Anthropic (Claude API) --- [REQUERIDO]
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
# Modelo a usar (default: claude-sonnet-4-5-20250514)
# LLM_MODEL=claude-sonnet-4-5-20250514

# --- Mendix Platform SDK --- [REQUERIDO para operaciones con .mpr]
MENDIX_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Figma --- [OPCIONAL - solo si se usa input desde Figma]
# FIGMA_ACCESS_TOKEN=figd_xxxxxxxxxxxxxxxxxxxx

# --- Servidor REST ---
# HOST=127.0.0.1
# PORT=8000

# --- Cache LLM ---
# CACHE_TTL_DAYS=7
# CACHE_DB_PATH=cache/llm_responses.db

# --- Logging ---
# LOG_LEVEL=INFO
# DECISIONS_LOG_PATH=logs/decisions.jsonl

# --- Knowledge Base ---
# CHROMA_DB_PATH=knowledge_base/chroma_db
# BP_DOCS_PATH=knowledge_base/mendix_bp_official

# --- Convenciones ---
# CONVENTIONS_PATH=conventions/copeinca_conventions.yaml

# --- Rollback ---
# MAX_BACKUPS=5
